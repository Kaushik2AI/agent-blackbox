# Copy to .env and change the passwords (Docker path). Without Docker you don't need
# this file: `make setup` generates .env with random passwords and per-user ports.
ENVIRONMENT=development

PG_PORT=5432
PG_USER=blackbox
PG_PASSWORD=change-me-postgres
PG_DATABASE=blackbox
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
API_PORT=8000
WEB_PORT=3000

# Must match the values above.
DATABASE_URL=postgresql+psycopg://blackbox:change-me-postgres@127.0.0.1:5432/blackbox
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0
API_INTERNAL_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional: serve the web UI under a path prefix (reverse proxies). Usually empty.
NEXT_BASE_PATH=

# Optional: real AI for the live demo. Any OpenAI-compatible chat endpoint.
# `make qwen-setup` fills these in for a Qwen model running on this machine.
# Without LLM_API_KEY the home page offers only the scripted agent.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
